# Example environment variables (DO NOT COMMIT REAL TOKENS)
TRADING_MODE=PAPER
PAPER_VIA_PLATFORM=1
ALLOW_LIVE_REAL=0
TEST_ORDER_MAX_USD=10
TEST_ORDER_MAX_PER_DAY=2

# OANDA practice API
OANDA_API_TOKEN=
# If you use separate IDs, keep both set; the runner will prefer OANDA_PRACTICE_ACCOUNT_ID in PAPER/PRACTICE.
OANDA_ACCOUNT_ID=
OANDA_PRACTICE_ACCOUNT_ID=
OANDA_MODE=PAPER
OANDA_API_URL=https://api-fxpractice.oanda.com
# Trailing-stop monitor configuration (server-side trailing activation)
# Activate trailing stops only after this much unrealized profit (in pips)
OANDA_TRAIL_ACTIVATION_PIPS=20
# Trailing distance once activated (in pips)
OANDA_TRAIL_DISTANCE_PIPS=20
# How often (seconds) the monitor checks open trades
OANDA_TRAIL_MONITOR_INTERVAL_SECONDS=60
# Enable/disable background trailing monitor (true/false)
# OANDA_TRAIL_MONITOR_ENABLED=false
# Position and reversal controls
OANDA_MAX_POSITIONS_PER_INSTRUMENT=1
OANDA_ALLOW_REVERSAL_ON_OPPOSITE_SIGNAL=true
# Minimum confidence for processing signals (optional) - set to 0 to disable
OANDA_SIGNAL_CONFIDENCE_THRESHOLD=0.70
# Minimum confidence required to perform a reversal (opposite signal)
OANDA_REVERSAL_MIN_CONFIDENCE=0.75
# Initial tight stop in pips applied at entry when stop not provided
OANDA_INITIAL_STOP_PIPS=5
# Use platform paper (where available) by default
PAPER_VIA_PLATFORM=1
# Default headless runner mode. Can be: auto, platform-paper, simulate, oanda-only, coinbase-only, ibkr-only
HEADLESS_MODE=multi-asset

# Multi-strategy configuration (comma-separated list)
ENABLED_STRATEGIES=fabio_aaa_full,holy_grail,ema_scalper,institutional_sd

# AI Hive Configuration (GPT + xAI + DeepSeek)
ENABLE_AI_HIVE=true
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
AI_HIVE_MIN_CONSENSUS=2
# Emergency bypass (manual override to disable Hive temporarily)
HIVE_EMERGENCY_BYPASS=false
# Autonomous repair (let AIs diagnose and fix Hive failures)
HIVE_AUTONOMOUS_REPAIR=false

# IBKR and Coinbase settings (if used)
# IBKR Paper Trading (Port 4002 = Paper, 4001 = Live)
IBKR_HOST=localhost
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_PAPER_MODE=true
IBKR_ENABLED=true
# Coinbase (NO paper account - will use real money with strict limits)
COINBASE_API_KEY=
COINBASE_API_SECRET=
# Preferred for Coinbase CDP/JWT auth: point to your PEM file instead of embedding secrets in .env
COINBASE_API_SECRET_FILE=
# Coinbase nano-lot safety limits
COINBASE_MIN_TRADE_USD=5.0
COINBASE_MAX_TRADE_USD=10.0
COINBASE_DAILY_LOSS_LIMIT=50.0
COINBASE_MAX_TRADES_PER_DAY=999999
COINBASE_STOP_ON_CONSECUTIVE_LOSSES=5

# Headless runner configuration
FEED_SYMBOLS=BTC-USD,ETH-USD
HEADLESS_POLL_SECONDS=2.0
DEFAULT_STRATEGY=institutional_sd

# AI HIVE CONFIGURATION
USE_HIVE_VALIDATION=true
AI_HIVE_DAILY_BUDGET_USD=10.0
XAI_COST_PER_CALL=0.001
OPENAI_COST_PER_CALL=0.002
DEEPSEEK_COST_PER_CALL=0.0005
HIVE_STRATEGY_FIRST=true
HIVE_ONLY_ON_SIGNAL=true
AI_HIVE_MIN_CONSENSUS=2
HIVE_EMERGENCY_BYPASS=false
ENABLE_AI_HIVE=true

# CANARY MODE: Ultra-conservative testing mode with verbose narration
CANARY_MODE=false
CANARY_POLL_SECONDS=30.0
CANARY_MAX_RISK_USD=10.0

# Safety Tripwires (applies to all brokers)
MAX_DRAWDOWN_PCT=10.0
MAX_CONSECUTIVE_LOSSES=5
DAILY_LOSS_LIMIT_USD=100.0
VOLATILITY_CIRCUIT_BREAKER_PCT=15.0
REQUIRE_EDGE_VALIDATION=true
MIN_WIN_RATE_PCT=55.0
MIN_PROFIT_FACTOR=1.5

# Market session awareness
SESSION_AWARE_TRADING=true
PREFERRED_SESSIONS=NEW_YORK,LONDON,TOKYO
TRADE_DURING_OVERLAP_ONLY=true
QUIET_HOURS_ENABLED=false
