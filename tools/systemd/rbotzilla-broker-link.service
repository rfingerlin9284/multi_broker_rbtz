[Unit]
Description=RBOTzilla Broker Link Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ing
WorkingDirectory=/home/ing/RICK/MULTI_BROKER_PHOENIX
EnvironmentFile=/home/ing/RICK/MULTI_BROKER_PHOENIX/.env
ExecStart=/home/ing/RICK/MULTI_BROKER_PHOENIX/tools/run_broker_link.sh
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=10
TimeoutStartSec=30
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
