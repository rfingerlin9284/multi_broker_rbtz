[Unit]
Description=Phoenix IBKR Reconcile Service
After=network.target

[Service]
Type=oneshot
User=%U
WorkingDirectory=%h/RICK/MULTI_BROKER_PHOENIX
ExecStart=%h/RICK/MULTI_BROKER_PHOENIX/.venv/bin/python tools/reconcile_ibkr.py --report --output data/reconcile_ibkr.json
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
