[Unit]
Description=RBOTzilla Engine (Paper)
After=rbotzilla-broker-link.service
Wants=rbotzilla-broker-link.service

[Service]
Type=simple
User=ing
WorkingDirectory=/home/ing/RICK/MULTI_BROKER_PHOENIX
EnvironmentFile=/home/ing/RICK/MULTI_BROKER_PHOENIX/.env
# Pre-start check: ensure broker_link state file is recent
ExecStartPre=/bin/sh -c 'if [ -f /home/ing/RICK/MULTI_BROKER_PHOENIX/ops/state/broker_link.json ]; then age=$(($(date +%s)-$(jq -r .last_heartbeat /home/ing/RICK/MULTI_BROKER_PHOENIX/ops/state/broker_link.json || echo 0))); if [ "$age" -gt 300 ]; then echo "Broker link stale (age=$age)"; exit 1; fi; fi'
ExecStart=/home/ing/RICK/MULTI_BROKER_PHOENIX/tools/run_engine_paper.sh
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=10
TimeoutStartSec=60
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
