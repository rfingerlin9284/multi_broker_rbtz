# RBOTZILLA CORE EXTRACT - Required Environment Variables
# Copy this file to .env and fill in your actual values

# ====================
# OANDA PRACTICE API
# ====================
OANDA_API_TOKEN=your_practice_api_token_here
OANDA_ACCOUNT_ID=your_practice_account_id_here
OANDA_API_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_URL=https://stream-fxpractice.oanda.com
OANDA_PRACTICE=true
OANDA_MODE=PAPER

# ====================
# IBKR PAPER TRADING
# ====================
IBKR_ENABLED=true
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1

# ====================
# COINBASE (OPTIONAL)
# ====================
# Set COINBASE_LIVE=true ONLY for real money trading
COINBASE_LIVE=false
# COINBASE_API_KEY=your_api_key
# COINBASE_API_SECRET=your_api_secret

# ====================
# AI HIVE (OPTIONAL)
# ====================
ENABLE_AI_HIVE=true
OPENAI_API_KEY=your_openai_api_key
XAI_API_KEY=your_xai_grok_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
HIVE_APPROVAL_THRESHOLD=0.30

# ====================
# TRADING CONFIGURATION
# ====================
TRADING_MODE=PAPER
DEFAULT_STRATEGY=holy_grail
ENABLED_STRATEGIES=fabio_aaa_full,holy_grail,ema_scalper
FEED_SYMBOLS=EUR_USD,GBP_USD,USD_JPY,BTC-USD,ETH-USD

# ====================
# RISK LIMITS
# ====================
MAX_RISK_USD_PER_TRADE=30.0
CANARY_MAX_RISK_USD=10.0

# ====================
# CANARY MODE (ULTRA-CONSERVATIVE)
# ====================
CANARY_MODE=false
CANARY_POLL_SECONDS=30.0

# ====================
# HEADLESS RUNNER
# ====================
HEADLESS_POLL_SECONDS=2.0
HEADLESS_MODE=auto
