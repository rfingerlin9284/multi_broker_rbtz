# RBOTzilla Secrets Template
# Copy this to ops/secrets.env and fill in your actual values.
# This file is gitignored and will NEVER be committed.

# OANDA Practice API Credentials
OANDA_API_TOKEN=your_oanda_token_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_API_URL=https://api-fxpractice.oanda.com

# AI Seat API Keys (optional - only fill if you want to use these seats)
XAI_API_KEY=your_xai_key_here_or_leave_empty
DEEPSEEK_API_KEY=your_deepseek_key_here_or_leave_empty
OPENAI_API_KEY=your_openai_key_here_or_leave_empty

# Ollama (local brain - usually defaults work)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
